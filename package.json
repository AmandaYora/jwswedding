{
  "name": "jwswedding",
  "private": true,
  "version": "0.1.0",
  "description": "JWS Wedding — monorepo (Dimas standard)",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "node scripts/go-tool.mjs --cwd=apps/api air",
    "build:web": "npm run build -w apps/web",
    "build:api": "cd apps/api && go build -o ../../dist/api ./cmd/server",
    "migrate:up": "node scripts/go-tool.mjs --cwd=apps/api migrate -path migrations -database {{DATABASE_URL}} up",
    "migrate:down": "node scripts/go-tool.mjs --cwd=apps/api migrate -path migrations -database {{DATABASE_URL}} down 1",
    "migrate:create": "node scripts/go-tool.mjs --cwd=apps/api migrate create -ext sql -dir migrations -seq",
    "sqlc:generate": "node scripts/go-tool.mjs --cwd=apps/api sqlc generate"
  }
}
