APP_ENV=development
APP_PORT=8080
APP_NAME=JWS Wedding

# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME feed two different things:
# - DATABASE_URL below (used when running the API directly on the host, e.g.
#   `npm run dev:api` or `npm run migrate:up`) — keep DB_HOST=localhost here.
# - docker-compose.yml's own DATABASE_URL override, which reuses these same
#   DB_USER/DB_PASSWORD/DB_PORT/DB_NAME values but swaps the host for
#   `host.docker.internal` so the app container can reach a host-run MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jwswedding_db
DATABASE_URL=mysql://root:@tcp(localhost:3306)/jwswedding_db

JWT_SECRET=change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

# Dibaca frontend, bukan backend. Vite diarahkan ke file ini lewat `envDir` di
# apps/web/vite.config.ts, jadi satu .env melayani kedua app — jangan buat
# apps/web/.env terpisah, Vite tidak akan membacanya.
#
# Hanya berlaku untuk dev, saat Vite (5173) dan Go (8080) jadi dua server
# berbeda sehingga panggilan API butuh URL absolut. Build Docker tidak pernah
# melihat file ini (.dockerignore membuang .env), jadi di sana nilainya kosong
# dan frontend memakai path relatif — benar, karena satu container menyajikan
# API dan web di origin yang sama.
#
# Hanya variabel ber-awalan VITE_ yang masuk ke bundle frontend; sisanya di
# file ini tidak pernah terlihat browser.
VITE_API_BASE_URL=http://localhost:8080

# Object storage (S3-compatible — IDCloudHost Object Storage or any S3-compatible
# provider). See ADR-0006. Never commit real keys — this file only ever holds
# placeholders.
S3_ENDPOINT=change-me.example.com
S3_BUCKET=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_USE_SSL=true

# jwswedding is a `kind=external` App consuming ElProof's API to pay for its
# own subscription (see knowledge/decisions/ADR-0021-standalone-jws-payment-via-elproof-api.md).
# Register the App via the ElProof Platform Console first — ELPROOF_APP_SECRET
# is shown only once at registration time and cannot be viewed again afterwards.
ELPROOF_PAYMENT_BASE_URL=https://elproof.elcodelabs.com/api/v1
ELPROOF_APP_ID=change-me
ELPROOF_APP_SECRET=change-me

# How often the platform module re-checks pending charges whose webhook was
# never received, directly against ElProof (safety net for missed webhooks).
ELPROOF_RECONCILE_INTERVAL=3m

# How old a pending charge must be, with a definitive "unpaid" answer from
# ElProof, before the reconciler force-closes it as failed. A charge whose
# status check errors is never force-closed regardless of age.
ELPROOF_CHARGE_MAX_AGE=24h
